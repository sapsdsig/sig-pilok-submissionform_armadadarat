{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "api",
    "server",
    "scripts",
    "src/constants/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/validation/**/*.ts"
  ]
}
